---
/**
 * Home hero: brand, one-line promise, brand-kit ভাবু, two CTAs.
 * Background = the three brand patterns drifting slowly (CSS only, stops for reduced motion).
 * Mobile: capped at ~70svh so the first photo cards stay close.
 * ভাবু art is the brand-kit PNG (as WebP) served from /media/brand/; if it is missing the
 * code-drawn ভাবু shows instead.
 */
import Bhabu from '../brand/Bhabu.astro';
---
<section class="bj-hero relative isolate overflow-hidden bg-teal text-white" aria-labelledby="home-hero-title">
  <div class="bj-hero-bg" aria-hidden="true">
    <span class="bj-hero-layer bj-l1"></span>
    <span class="bj-hero-layer bj-l2"></span>
    <span class="bj-hero-glow"></span>
  </div>
  <div class="wrap relative grid max-h-[70svh] grid-cols-[1fr_auto] items-center gap-3 py-7 sm:py-12 lg:max-h-none lg:gap-10 lg:py-14">
    <div class="min-w-0" data-parallax="0.06">
      <p class="inline-flex items-center gap-2 rounded-full bg-white/15 px-3 py-1 text-sm font-bold ring-1 ring-white/25">
        <span class="h-2 w-2 rounded-full bg-sun" aria-hidden="true"></span>কৌতূহলী বাংলাদেশের ঘর
      </p>
      <h1 id="home-hero-title" class="mt-3 font-display text-[2.9rem] leading-[1.05] sm:text-7xl">
        ভাবা <span class="text-sun">যায়!</span>
      </h1>
      <p class="mt-3 max-w-xl text-[1.12rem] leading-snug text-white/90 sm:text-2xl">
        প্রতিদিনের চেনা জিনিসের ভেতরে লুকানো অবাক বিজ্ঞান, সূত্রসহ, সহজ বাংলায়।
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/series" class="btn btn-primary min-h-12 px-5 text-[1.05rem]">সিরিজ দেখো</a>
        <a href="/quiz" class="btn min-h-12 bg-white px-5 text-[1.05rem] text-deep hover:bg-sun">কুইজ খেলো</a>
      </div>
    </div>
    <div class="relative self-center" data-parallax="-0.1">
      <img src="/media/brand/bhabu-happy-reverse.webp" width="279" height="640" alt="ভাবু, ভাবা যায়!-এর মাসকট, হাসিমুখে হাত নাড়ছে"
        class="bj-hero-bhabu relative z-10 h-[13rem] w-auto sm:h-[18rem] lg:h-[21rem] drop-shadow-[0_14px_20px_rgb(0_0_0/.25)]"
        fetchpriority="high" decoding="async"
        onerror="this.hidden=true;this.nextElementSibling.hidden=false" />
      <span hidden class="block w-24 sm:w-36"><Bhabu face="happy" body="coral" dot="sun" class="w-full" /></span>
    </div>
  </div>
</section>

<style>
  .bj-hero-bg { position: absolute; inset: 0; z-index: -1; }
  .bj-hero-layer { position: absolute; inset: -20%; background-repeat: repeat; will-change: transform; }
  .bj-l1 { background-image: url('/patterns/teal.svg'); background-size: 260px; opacity: .55; animation: bj-drift 60s linear infinite; }
  .bj-l2 { background-image: url('/patterns/mint.svg'); background-size: 420px; opacity: .12; mix-blend-mode: screen; animation: bj-drift 90s linear infinite reverse; }
  .bj-hero-glow { position: absolute; inset: 0; background: radial-gradient(60% 70% at 85% 30%, rgb(255 107 91 / .35), transparent 70%), radial-gradient(50% 60% at 0% 100%, rgb(126 224 194 / .25), transparent 70%); }
  .bj-hero-bhabu { animation: bj-float 5s ease-in-out infinite; transform-origin: bottom center; }
  @keyframes bj-drift { to { transform: translate3d(260px, 130px, 0); } }
  @media (prefers-reduced-motion: reduce) {
    .bj-hero-layer, .bj-hero-bhabu { animation: none; }
  }
</style>
