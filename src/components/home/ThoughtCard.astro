---
/** আজকের ভাবনা — one question card, ভাবু peeking. Tap → the answer flips in. Changes daily at 08:00 Dhaka. */
import Bhabu from '../brand/Bhabu.astro';
import Icon from '../ui/Icon.astro';
import { thoughts } from '../../lib/content';
import { thoughtIndex } from '../../lib/time';
interface Props { class?: string }
const { class: cls } = Astro.props;
const t = thoughts[thoughtIndex(thoughts.length)];
---
<section class:list={['flip h-[15.5rem] sm:h-64', cls]} data-thought aria-labelledby="thought-q">
  <div class="flip-inner">
    <div class="flip-face flip-front absolute inset-0 overflow-hidden rounded-[26px] bg-teal p-5 text-white shadow-[var(--shadow-lift)] sm:p-6">
      <div class="pattern-teal absolute inset-0 [mask-image:linear-gradient(to_left,#000_8%,transparent_62%)]" aria-hidden="true"></div>
      <div class="relative z-10 max-w-[72%]">
        <p class="text-sm font-bold text-sun">আজকের ভাবনা</p>
        <h2 id="thought-q" class="mt-1 text-[1.55rem] font-bold leading-snug sm:text-[1.75rem]" data-thought-q>{t.q}</h2>
        <button type="button" class="btn btn-pill mt-4" data-thought-flip>উত্তর দেখো</button>
        <p class="mt-3 text-xs text-white/70">প্রতিদিন সকাল ৮টায় নতুন প্রশ্ন</p>
      </div>
      <div class="absolute -bottom-6 -right-3 w-28 rotate-[-8deg] sm:w-32" aria-hidden="true">
        <Bhabu face="think" body="coral" dot="sun" brows="light" animateSparks class="w-full" />
      </div>
    </div>
    <div class="flip-face flip-back overflow-y-auto rounded-[26px] bg-deep p-5 text-white shadow-[var(--shadow-lift)] sm:p-6" aria-hidden="true">
      <p class="text-sm font-bold text-sun">উত্তর</p>
      <p class="mt-1 text-[1.06rem] font-semibold leading-relaxed" data-thought-a>{t.a}</p>
      <p class="mt-2 text-xs text-white/60" data-thought-src>{t.source ? `সূত্র: ${t.source.label}` : ''}</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button type="button" class="btn btn-sm btn-white" data-share data-share-url="/" data-share-title={t.q} data-share-text={`আজকের ভাবনা: ${t.q}`} data-thought-share>
          <Icon name="share" class="h-4 w-4" />শেয়ার
        </button>
        <button type="button" class="btn btn-sm border-2 border-white/40 !shadow-none text-white" data-thought-flip>আবার প্রশ্ন</button>
      </div>
    </div>
  </div>
</section>

<script type="application/json" data-thoughts-json set:html={JSON.stringify(thoughts.map((x) => ({ q: x.q, a: x.a, s: x.source?.label ?? '' })))} />
<script>
  import { thoughtIndex } from '../../lib/time';
  import { markThoughtSeen, toast } from '../../lib/store';
  import { sound } from '../../lib/fx';

  const data: { q: string; a: string; s: string }[] = JSON.parse(document.querySelector('[data-thoughts-json]')?.textContent || '[]');
  const t = data[thoughtIndex(data.length)];
  document.querySelectorAll<HTMLElement>('[data-thought]').forEach((card) => {
    if (t) {
      card.querySelectorAll('[data-thought-q]').forEach((el) => (el.textContent = t.q));
      card.querySelectorAll('[data-thought-a]').forEach((el) => (el.textContent = t.a));
      card.querySelectorAll('[data-thought-src]').forEach((el) => (el.textContent = t.s ? `সূত্র: ${t.s}` : ''));
      card.querySelectorAll<HTMLElement>('[data-thought-share]').forEach((b) => {
        b.dataset.shareTitle = t.q;
        b.dataset.shareText = `আজকের ভাবনা: ${t.q} — উত্তর জানো?`;
      });
    }
    card.querySelectorAll('[data-thought-flip]').forEach((btn) =>
      btn.addEventListener('click', () => {
        card.classList.toggle('is-flipped');
        const flipped = card.classList.contains('is-flipped');
        card.querySelector('.flip-front')?.setAttribute('aria-hidden', String(flipped));
        card.querySelector('.flip-back')?.setAttribute('aria-hidden', String(!flipped));
        sound.pop();
        if (flipped && markThoughtSeen()) toast('ভাবা যায়! আজকের ভাবনা +৫ পয়েন্ট', { mood: 'wow' });
      }),
    );
  });
</script>
