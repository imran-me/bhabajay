---
/** Static SEO shell for a core-team series whose posts live in the database (loaded by LivePosts). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Doodle from '../brand/Doodle.astro';
import Icon from '../ui/Icon.astro';
import LivePosts from '../islands/LivePosts';
import { bnDate } from '../../lib/bn';
import type { LibrarySeries } from '../../lib/library';

interface Props { s: LibrarySeries }
const { s } = Astro.props;
const light = s.color.ink === 'light';
const jsonLd = {
  '@type': 'CreativeWorkSeries',
  name: s.title,
  description: s.description,
  inLanguage: 'bn',
  author: { '@type': 'Organization', name: 'ভাবা যায়!' },
  startDate: s.launchedAt,
};
---
<BaseLayout title={`${s.title} — ${s.tagline}`} description={s.description} jsonLd={jsonLd}>
  <section class="relative overflow-hidden" style={`background: linear-gradient(120deg, ${s.color.from}, ${s.color.to})`}>
    <div class="absolute inset-0 opacity-25" style="background-image:url(/patterns/teal.svg);background-size:240px;mix-blend-mode:soft-light" aria-hidden="true"></div>
    <div class:list={['wrap relative py-8 sm:py-12', light ? 'text-white' : 'text-deep']}>
      <a href="/series" class:list={['-my-2 inline-flex min-h-11 items-center gap-1 text-sm font-semibold', light ? 'text-white/85' : 'text-deep/75']}><Icon name="arrow-left" class="h-4 w-4" />সব সিরিজ</a>
      <p class:list={['mt-3 inline-block rounded-full px-3 py-1 text-sm font-bold', light ? 'bg-white/20' : 'bg-deep/10']}>ভাবা যায়! সিরিজ · {s.subject}</p>
      <h1 class="mt-3 max-w-[75%] font-bold text-[2.3rem] leading-tight sm:text-6xl">{s.title}</h1>
      <p class:list={['mt-2 max-w-[70%] text-lg', light ? 'text-white/90' : 'text-deep/80']}>{s.tagline}</p>
      <Doodle name={s.doodle} class="absolute right-4 top-1/2 h-28 w-28 -translate-y-1/2 rotate-[8deg] sm:right-10 sm:h-44 sm:w-44" />
    </div>
  </section>

  <section class="wrap mt-6 max-w-3xl">
    <p class="text-lg leading-relaxed">{s.description}</p>
    <p class="mt-2 text-sm text-ink-soft">লেখা, তথ্য যাচাই আর ছবি-কার্ড: ভাবা যায়! কোর টিম · প্রতিটা তথ্যের অন্তত দুটো সূত্র · শুরু {bnDate(s.launchedAt)}</p>
  </section>

  <section class="wrap mt-8" aria-labelledby="posts-title">
    <h2 id="posts-title" class="mb-4 text-2xl font-bold">পোস্টগুলো</h2>
    <LivePosts client:visible series={s.slug} teaserTitle={`${s.title}: ${s.tagline}`} empty={`প্রথম পোস্ট আসছে ${bnDate(s.launchedAt)}। ফেসবুকে ভাবা যায়! ফলো করে রাখুন, প্রকাশ হলেই এখানেও দেখা যাবে।`} />
  </section>
</BaseLayout>
