---
/**
 * Wall of Fame card. Front: avatar (or photo, 18+ only), name, tier ring
 * colour, series, 2 proof numbers, mentor. Tap = flip → the original question,
 * pitch date, journey timeline, and a verify link universities can check.
 */
import Avatar from '../ui/Avatar.astro';
import Icon from '../ui/Icon.astro';
import type { Person } from '../../data/types';
import { getSeries, getMentor, personProof, displayName } from '../../lib/content';
import { bn, bnDate, TIER_LABEL } from '../../lib/bn';
interface Props { p: Person }
const { p } = Astro.props;
const s = p.seriesSlug ? getSeries(p.seriesSlug) : undefined;
const m = getMentor(p.mentorId);
const proof = personProof(p);
const frame = { legend: 'border-sun bg-sun', initiator: 'border-coral bg-surface', explorer: 'border-teal bg-surface', curious: 'border-mint-dark bg-surface' }[p.tier];
const proofs: string[] = [];
if (p.tier === 'legend') {
  if (proof.research) proofs.push(`📄 ${bn(proof.research)} গবেষণা`);
  if (proof.forums) proofs.push(`🎤 ${bn(proof.forums)} ফোরাম`);
} else {
  proofs.push(`${bn(proof.posts)} ${p.tier === 'explorer' && s?.ownerId !== p.id ? 'অবদান' : 'পোস্ট'}`);
  if (proof.videos) proofs.push(`${bn(proof.videos)} ভিডিও`);
  else if (proof.team > 1) proofs.push(`টিম ${bn(proof.team)}`);
}
const dark = p.tier === 'legend';
---
<div class="flip h-[22rem]" data-fame-card data-tier={p.tier} data-topic={s?.topic ?? ''}>
  <div class="flip-inner">
    <button type="button" class:list={['flip-face flip-front card absolute inset-0 flex flex-col items-center border-[3px] p-5 text-center', frame, p.tier === 'legend' && 'legend-shimmer']} aria-label={`${displayName(p)} — কার্ড উল্টাও`} data-flip>
      <Avatar avatar={p.avatar} tier={p.tier} class="mt-2 h-28 w-28" />
      <h3 class:list={['mt-3 text-2xl font-bold', dark && 'text-deep']}>{displayName(p)}</h3>
      <p class:list={['text-sm font-semibold', dark ? 'text-deep/80' : 'text-ink-soft']}>{TIER_LABEL[p.tier].bn}{s ? ` · ${s.title}` : ''}</p>
      <p class:list={['mt-3 flex flex-wrap justify-center gap-x-3 text-sm font-bold', dark ? 'text-deep' : 'text-link']}>
        {proofs.map((x) => <span>{x}</span>)}
      </p>
      {m && <p class:list={['mt-auto text-xs', dark ? 'text-deep/75' : 'text-ink-soft']}>মেন্টর: {m.name}</p>}
      <span class:list={['absolute bottom-3 right-3 inline-flex items-center gap-1 text-xs font-bold', dark ? 'text-deep/70' : 'text-ink-soft']}><Icon name="refresh" class="h-3.5 w-3.5" />উল্টাও</span>
    </button>
    <div class="flip-face flip-back card flex flex-col overflow-hidden bg-deep p-5 text-white">
      <p class="text-xs font-bold text-sun">যে প্রশ্ন দিয়ে শুরু</p>
      <p class="mt-1 text-lg font-bold leading-snug">“{p.originalQuestion ?? 'প্রথম প্রশ্নটা এখনো খুঁজছে!'}”</p>
      {p.pitchDate && <p class="mt-1 text-xs text-white/70">পিচ: {bnDate(p.pitchDate)}</p>}
      <ol class="mt-3 grid gap-1.5 overflow-hidden text-[.8rem] leading-snug">
        {p.journey.slice(-4).map((j) => (
          <li class="flex gap-2"><span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-coral"></span><span><span class="text-white/60">{bnDate(j.date, { year: false })}</span> · {j.label}</span></li>
        ))}
      </ol>
      <div class="mt-auto flex items-center gap-2 pt-3">
        <a href={`/u/${p.username}`} class="btn btn-white btn-sm flex-1">প্রোফাইল</a>
        {p.verifyCode && <a href={`/verify/${p.verifyCode}`} class="btn btn-sm border-2 border-white/40 !shadow-none text-white" title="খেতাব যাচাই করো"><Icon name="shield" class="h-4 w-4" />যাচাই</a>}
        <button type="button" class="btn-icon text-white hover:!bg-white/10" data-flip aria-label="আবার উল্টাও"><Icon name="refresh" /></button>
      </div>
    </div>
  </div>
</div>
