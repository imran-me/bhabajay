---
import Doodle from '../brand/Doodle.astro';
import Avatar from '../ui/Avatar.astro';
import type { Series } from '../../data/types';
import { getPerson, seriesStats, isNew, liveEpisodes } from '../../lib/content';
import { bn } from '../../lib/bn';
interface Props { s: Series; size?: 'row' | 'grid' }
const { s, size = 'row' } = Astro.props;
const owner = getPerson(s.ownerId);
const st = seriesStats(s.slug);
const latest = s.kind === 'cartoon' ? liveEpisodes.at(-1)?.publishedAt : st.latest;
const fresh = isNew(latest, 10);
const href = s.kind === 'cartoon' ? '/bhabur-duniya' : `/series/${s.slug}`;
const light = s.color.ink === 'light';
const count = s.kind === 'cartoon' ? `${bn(liveEpisodes.length)} পর্ব` : `${bn(st.posts)} পোস্ট${st.videos ? ` · ${bn(st.videos)} ভিডিও` : ''}`;
---
<article class:list={['card card-hover press group relative overflow-hidden', size === 'row' ? 'w-[15.5rem] sm:w-[17rem]' : '']}>
  <div class="relative h-32 overflow-hidden sm:h-36" style={`background: linear-gradient(135deg, ${s.color.from}, ${s.color.to})`}>
    <div class="absolute inset-0 opacity-30" style="background-image:url(/patterns/teal.svg);background-size:220px;mix-blend-mode:soft-light"></div>
    <Doodle name={s.doodle} class="absolute -right-2 top-3 h-24 w-24 rotate-[10deg] transition-transform duration-500 group-hover:rotate-[2deg] group-hover:scale-105" />
    <p class:list={['absolute left-4 top-3 rounded-full px-2.5 py-0.5 text-xs font-bold', light ? 'bg-white/20 text-white' : 'bg-deep/10 text-deep']}>{s.subject}</p>
    {fresh && (
      <span class="absolute right-3 top-3 flex items-center gap-1.5 rounded-full bg-white px-2 py-0.5 text-xs font-bold text-coral-dark"><span class="new-dot !h-2 !w-2 !shadow-none"></span>নতুন</span>
    )}
    <h3 class:list={['absolute bottom-3 left-4 right-20 text-[1.3rem] font-bold leading-tight', light ? 'text-white' : 'text-deep']}>
      <a href={href} class="after:absolute after:inset-0 after:content-['']">{s.title}</a>
    </h3>
  </div>
  <div class="flex items-center gap-2.5 p-3">
    {owner && <Avatar avatar={owner.avatar} tier={owner.id === 'core' ? 'none' : owner.tier} class="h-9 w-9" />}
    <div class="min-w-0 leading-tight">
      <p class="truncate text-sm font-bold">{owner?.id === 'core' ? 'ভাবা যায়! কোর টিম' : owner?.nickname}</p>
      <p class="text-xs text-ink-soft">{count}</p>
    </div>
  </div>
</article>
