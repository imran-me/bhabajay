---
import ArtPanel from './ArtPanel.astro';
import Icon from '../ui/Icon.astro';
import type { Post } from '../../data/types';
import { bn, FORMAT_LABEL, TOPIC_LABEL } from '../../lib/bn';
import { isNew } from '../../lib/content';
interface Props { post: Post; showSeries?: string }
const { post, showSeries } = Astro.props;
const href = `/series/${post.seriesSlug}/${post.slug}`;
const fresh = isNew(post.publishedAt, 7);
---
<article class="card card-hover press group relative overflow-hidden">
  <a href={href} class="block" aria-label={post.title}>
    <ArtPanel bg={post.art.bg} doodle={post.art.doodle} class="aspect-[4/5]">
      <div class="absolute left-3 top-3 flex gap-1.5">
        {post.format !== 'card' && (
          <span class="inline-flex items-center gap-1 rounded-full bg-deep/85 px-2.5 py-0.5 text-xs font-bold text-white">
            <Icon name={post.format === 'video' ? 'play' : 'file'} class="h-3.5 w-3.5" />{FORMAT_LABEL[post.format]}
          </span>
        )}
        {fresh && <span class="rounded-full bg-coral px-2.5 py-0.5 text-xs font-bold text-white">নতুন</span>}
      </div>
      <div class="absolute inset-x-2.5 bottom-2.5 rounded-2xl bg-white/95 p-3 text-deep shadow-sm sm:inset-x-3 sm:bottom-3">
        <h3 class="text-[1.02rem] font-bold leading-snug sm:text-lg">{post.title}</h3>
      </div>
    </ArtPanel>
  </a>
  <div class="flex items-center gap-2 px-3 py-2.5 text-[.82rem] text-ink-soft">
    <span class="min-w-0 truncate">{showSeries ?? TOPIC_LABEL[post.topic]} · {bn(post.readMinutes)} মিনিট</span>
    <button type="button" class="btn-icon -my-2 ml-auto h-10 w-10 shrink-0 text-link aria-pressed:text-coral" data-save={`post:${post.slug}`} aria-pressed="false" aria-label="সেভ করো">
      <Icon name="bookmark" class="h-5 w-5 [[aria-pressed=true]_&]:fill-current" />
    </button>
  </div>
</article>
