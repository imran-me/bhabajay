---
import '../styles/global.css';
import Seo from '../components/layout/Seo.astro';
import TopBar from '../components/layout/TopBar.astro';
import BottomTabs from '../components/layout/BottomTabs.astro';
import Footer from '../components/layout/Footer.astro';
import Icon from '../components/ui/Icon.astro';
import { DEMO_MODE } from '../config/site';
import { facts } from '../lib/content';
import anekBn from '@fontsource-variable/anek-bangla/files/anek-bangla-bengali-wght-normal.woff2?url';
import balooBn800 from '@fontsource/baloo-da-2/files/baloo-da-2-bengali-800-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'video.other' | 'profile';
  noindex?: boolean;
  keywords?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  published?: string;
  /** page background treatment */
  ground?: 'warm' | 'mint';
  hideFooter?: boolean;
}
const { ground = 'warm', hideFooter = false, ...seo } = Astro.props;
const factsLite = facts.map((f) => f.text);
---
<!doctype html>
<html lang="bn" data-lang="bn" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFFBF4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#06272C" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={anekBn} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={balooBn800} as="font" type="font/woff2" crossorigin />
    <Seo {...seo} />
    <script is:inline>
      // Before paint: apply saved theme + UI language (no flash).
      (function () {
        var p = {};
        try { p = (JSON.parse(localStorage.getItem('bj:v1') || '{}').prefs) || {}; } catch (e) {}
        var d = document.documentElement;
        if (p.theme === 'light' || p.theme === 'dark') d.setAttribute('data-theme', p.theme);
        if (p.lang === 'en') { d.setAttribute('data-lang', 'en'); }
      })();
    </script>
  </head>
  <body class:list={['min-h-dvh pb-[calc(4rem+env(safe-area-inset-bottom))] lg:pb-0', ground === 'mint' && 'bg-tint']}>
    <a href="#main" class="skip-link">মূল লেখায় যাও</a>

    {DEMO_MODE && (
      <div data-demo-banner class="relative z-50 bg-deep text-white">
        <div class="wrap flex items-center gap-2 py-1.5 text-[.8rem] leading-snug">
          <span class="rounded-md bg-sun px-1.5 py-px font-bold text-deep">ডেমো</span>
          <span class="min-w-0 flex-1 truncate">ডেটাবেস যুক্ত হয়নি — আইডি, স্কোর আর পিচ শুধু এই ব্রাউজারে থাকছে।</span>
          <a href="/about#demo" class="shrink-0 font-semibold text-sun underline-offset-2 hover:underline">বিস্তারিত</a>
        </div>
      </div>
    )}

    <TopBar />

    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>

    {!hideFooter && <Footer />}
    <BottomTabs />

    <!-- toasts (ভাবু reacts) -->
    <div id="bj-toasts" aria-live="polite" class="pointer-events-none fixed inset-x-0 bottom-[calc(4.5rem+env(safe-area-inset-bottom))] z-[80] flex flex-col items-center gap-2 px-4 lg:bottom-6 lg:right-6 lg:left-auto lg:items-end"></div>

    <!-- share sheet (WhatsApp, Messenger, Facebook, copy, download card) -->
    <dialog id="bj-share" aria-labelledby="bj-share-title" class="m-0 mt-auto w-full max-w-none bg-transparent p-0 backdrop:bg-deep/50 sm:m-auto sm:max-w-md">
      <div class="rounded-t-[28px] bg-surface p-5 pb-[calc(1.25rem+env(safe-area-inset-bottom))] shadow-2xl sm:rounded-[28px]">
        <div class="mx-auto mb-3 h-1.5 w-12 rounded-full bg-line sm:hidden"></div>
        <div class="flex items-start gap-3">
          <div class="min-w-0 flex-1">
            <p id="bj-share-title" class="text-lg font-bold">শেয়ার করো</p>
            <p class="truncate text-sm text-ink-soft" data-share-preview></p>
          </div>
          <button type="button" class="btn-icon -mr-2 -mt-2" data-share-close aria-label="বন্ধ করো"><Icon name="x" /></button>
        </div>
        <div class="mt-4 grid grid-cols-5 gap-2 text-center text-xs font-semibold">
          <a data-share-wa target="_blank" rel="noopener" class="grid justify-items-center gap-1.5 rounded-2xl p-2 hover:bg-tint"><span class="grid h-12 w-12 place-items-center rounded-2xl bg-[#E7F8EE]"><Icon name="whatsapp" class="h-7 w-7" /></span>WhatsApp</a>
          <a data-share-ms target="_blank" rel="noopener" class="grid justify-items-center gap-1.5 rounded-2xl p-2 hover:bg-tint"><span class="grid h-12 w-12 place-items-center rounded-2xl bg-[#E6F2FF]"><Icon name="messenger" class="h-7 w-7" /></span>Messenger</a>
          <a data-share-fb target="_blank" rel="noopener" class="grid justify-items-center gap-1.5 rounded-2xl p-2 hover:bg-tint"><span class="grid h-12 w-12 place-items-center rounded-2xl bg-[#E8F0FE]"><Icon name="facebook" class="h-7 w-7" /></span>Facebook</a>
          <button type="button" data-share-copy class="grid justify-items-center gap-1.5 rounded-2xl p-2 hover:bg-tint"><span class="grid h-12 w-12 place-items-center rounded-2xl bg-tint text-link"><Icon name="link" class="h-6 w-6" /></span><span data-copy-label>লিংক কপি</span></button>
          <button type="button" data-share-card class="grid justify-items-center gap-1.5 rounded-2xl p-2 hover:bg-tint"><span class="grid h-12 w-12 place-items-center rounded-2xl bg-sun-soft text-mustard dark:text-sun"><Icon name="download" class="h-6 w-6" /></span><span data-card-label>কার্ড নামাও</span></button>
        </div>
        <button type="button" data-share-native hidden class="btn btn-secondary mt-4 w-full"><Icon name="share" /> ফোনের শেয়ার মেনু</button>
      </div>
    </dialog>

    <script type="application/json" id="bj-facts" set:html={JSON.stringify(factsLite)} />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
