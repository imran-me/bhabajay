---
import BaseLayout from '../layouts/BaseLayout.astro';
import Bhabu from '../components/brand/Bhabu.astro';
import { SITE } from '../config/site';
---
<BaseLayout title="গোপনীয়তা ও অভিভাবক" description="ভাবা যায়! কী তথ্য রাখে, কেন রাখে, আর কিশোরদের কীভাবে সুরক্ষিত রাখে — সহজ বাংলায়, এক পাতায়।">
  <article class="wrap max-w-3xl pt-6 sm:pt-10">
    <div class="flex items-start gap-4">
      <Bhabu face="happy" body="teal" dot="coral" class="w-14 shrink-0" />
      <div>
        <h1 class="font-display text-[2.2rem] leading-tight sm:text-5xl">গোপনীয়তা ও অভিভাবক</h1>
        <p class="mt-1 text-ink-soft">এক পাতায়, সহজ ভাষায়। সংস্করণ ০.১ — খসড়া, প্রকাশের আগে আইনি পর্যালোচনা হবে।</p>
      </div>
    </div>

    <div class="prose-bn mt-8">
      <h2>সংক্ষেপে</h2>
      <ul>
        <li>আমরা যতটা সম্ভব কম তথ্য রাখি। বিজ্ঞাপন নেই, তথ্য বিক্রি নেই, কুকি দিয়ে ট্র্যাকিং নেই।</li>
        <li>ইউজারনেম হবে ডাকনাম — আসল নাম নয়।</li>
        <li>ব্যবহারকারীদের মধ্যে সরাসরি মেসেজের ব্যবস্থা নেই। সব মন্তব্য প্রকাশের আগে মডারেট হয়।</li>
        <li>এক চাপে নিজের সব তথ্য নামানো বা মুছে ফেলা যায় (“আমার ভাবা যায়” → সেটিংস)।</li>
      </ul>

      <h2 id="parents">বয়স অনুযায়ী নিয়ম</h2>
      <p><b>১৩ বছরের নিচে:</b> কোনো অ্যাকাউন্ট খোলা হয় না। কুইজ খেলা যায় অতিথি হিসেবে — স্কোর শুধু সেই ফোন/ব্রাউজারেই থাকে, আমাদের সার্ভারে যায় না। কোনো পাবলিক প্রোফাইল বা মন্তব্য নেই।</p>
      <p><b>১৩ থেকে ১৭:</b> অভিভাবকের ইমেইলে একটা নিশ্চিতকরণ লিংক যায়; অভিভাবক নিশ্চিত না করা পর্যন্ত প্রোফাইল ব্যক্তিগত থাকে আর পিচ পাঠানো যায় না। প্রোফাইল সবসময় ডিফল্ট ব্যক্তিগত। পাবলিক নাম = ডাকনাম + অবতার — ছবি, স্কুলের নাম বা জেলা কখনো অভিভাবকের অনুমতি ছাড়া দেখানো হয় না। অভিভাবক যেকোনো সময় আমাদের লিখে অ্যাকাউন্ট মুছে দিতে বলতে পারেন।</p>
      <p><b>১৮ বা তার বেশি:</b> প্রোফাইল পাবলিক না ব্যক্তিগত — নিজে ঠিক করো। ইনিশিয়েটররা চাইলে ওয়াল অফ ফেমে আসল নাম ও ছবি দেখাতে পারেন (সিভি-তে কাজে লাগে)।</p>

      <h2>কী তথ্য রাখি, কেন</h2>
      <ul>
        <li><b>ইমেইল</b> — লগ ইন (Google বা ম্যাজিক লিংক) আর জরুরি খবরের জন্য। পাসওয়ার্ড আমরা কখনো দেখি না।</li>
        <li><b>ডাকনাম, ইউজারনেম, অবতার, বয়সের ধাপ</b> — প্রোফাইল আর নিরাপত্তা-নিয়মের জন্য। জন্মতারিখ নেই।</li>
        <li><b>কুইজের স্কোর, স্ট্রিক, ব্যাজ, সেভ</b> — খেলার অগ্রগতি দেখাতে।</li>
        <li><b>জেলা / স্কুল (ঐচ্ছিক)</b> — শুধু লিডারবোর্ডের জন্য।</li>
        <li><b>পিচের তথ্য</b> — রিভিউ, মেন্টর মেলানো আর ক্রেডিটের জন্য। নমুনা লিংক ঐচ্ছিক।</li>
        <li><b>অভিভাবকের ইমেইল (১৩–১৭)</b> — শুধু সম্মতি ও জরুরি খবরের জন্য।</li>
      </ul>

      <h2>কোথায় থাকে</h2>
      <p>তথ্য সুরক্ষিত ডেটাবেসে (Supabase) থাকে, যেখানে প্রতিটা টেবিলে “row-level security” — মানে তুমি শুধু নিজের তথ্য দেখতে পাও। পরিসংখ্যানের জন্য কুকিবিহীন অ্যানালিটিক্স ব্যবহার করি, যেটা কাউকে আলাদা করে চেনে না।</p>

      <h2>ভিডিও আর বাইরের লিংক</h2>
      <p>ইউটিউব বা ফেসবুকের ভিডিও তুমি চাপ দেওয়ার আগে লোড হয় না (তাই তারা আগে থেকে কিছু জানে না); চালালে তাদের নিজস্ব নীতি প্রযোজ্য। ইউটিউবের ক্ষেত্রে “privacy-enhanced” (youtube-nocookie) ব্যবহার করি।</p>

      <h2>যোগাযোগ</h2>
      <p>প্রশ্ন, অভিযোগ বা তথ্য মুছতে: <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>। আমরা ৭ দিনের মধ্যে উত্তর দিই।</p>
    </div>
  </article>
</BaseLayout>
