---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import WeeklyQuiz from '../../components/islands/WeeklyQuiz';
import { weeklies } from '../../lib/content';
---
<BaseLayout title="শনিবারের কুইজ — প্রতি শনিবার রাত ৮টা" description="প্রতি শনিবার রাত ৮টায় ৫টি নতুন প্রশ্ন। পরদিন সকাল ৮টায় উত্তর আর ব্যাখ্যা। বন্ধুদের চ্যালেঞ্জ দাও!">
  <div class="wrap max-w-3xl pt-5 sm:pt-8">
    <a href="/quiz" class="inline-flex min-h-11 items-center gap-1 font-bold text-link"><Icon name="arrow-left" class="h-4 w-4" />কুইজ জোন</a>
    <h1 class="mt-2 font-display text-[2.2rem] leading-tight sm:text-5xl">শনিবারের কুইজ</h1>
    <p class="mt-1 text-ink-soft">প্রতি শনিবার রাত ৮টায় ৫টি প্রশ্ন · প্রতিটায় ২০ সেকেন্ড · উত্তর আর ব্যাখ্যা পরদিন সকাল ৮টায়</p>
    <div class="mt-5">
      <WeeklyQuiz client:only="react" weeklies={weeklies}>
        <div slot="fallback" class="card grid h-72 place-items-center text-ink-soft">কুইজ সাজাচ্ছি…</div>
      </WeeklyQuiz>
    </div>
  </div>
</BaseLayout>
