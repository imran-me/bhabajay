---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EpisodeCard from '../../components/cards/EpisodeCard.astro';
import Bhabu from '../../components/brand/Bhabu.astro';
import { episodes, liveEpisodes, getSeries } from '../../lib/content';
import { castSvg, CAST } from '../../lib/cast';
import { bn, bnCompact } from '../../lib/bn';
import type { CastId } from '../../data/types';

const s = getSeries('bhabur-duniya')!;
const totalViews = liveEpisodes.reduce((a, e) => a + e.views, 0);
const cast = Object.keys(CAST) as CastId[];
const jsonLd = {
  '@type': 'TVSeries',
  name: 'ভাবুর দুনিয়া',
  description: s.description,
  inLanguage: 'bn',
  numberOfEpisodes: liveEpisodes.length,
  productionCompany: { '@type': 'Organization', name: 'ভাবা যায়!' },
};
---
<BaseLayout title="ভাবুর দুনিয়া — বাংলা বিজ্ঞান কার্টুন" description={s.description} jsonLd={jsonLd} image="/og/series/bhabur-duniya.png">
  <section class="pattern-deep text-white">
    <div class="wrap grid items-center gap-6 py-10 sm:py-14 lg:grid-cols-[1fr_auto]">
      <div class="rounded-3xl bg-deep/80 p-5 sm:p-7">
        <p class="font-bold text-sun">কার্টুন সিরিজ · {bn(liveEpisodes.length)} পর্ব · {bnCompact(totalViews)} বার দেখা</p>
        <h1 class="mt-2 font-display text-[2.6rem] leading-tight sm:text-6xl">ভাবুর দুনিয়া</h1>
        <p class="mt-3 max-w-xl text-lg text-white/85">{s.description}</p>
        <p class="mt-3 text-sm text-white/70">দেখো → খেলো → শেয়ার করো। প্রতি পর্বের শেষে ৩ প্রশ্নের কুইজ আর একটা ব্যাজ।</p>
      </div>
      <div class="hidden w-44 lg:block" aria-hidden="true"><Bhabu face="happy" body="coral" dot="sun" brows="light" animateSparks class="w-44" /></div>
    </div>
  </section>

  <section class="wrap mt-10" aria-labelledby="ep-title">
    <h2 id="ep-title" class="section-title">সব পর্ব</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {episodes.slice().reverse().map((ep) => <EpisodeCard ep={ep} />)}
    </div>
  </section>

  <section class="wrap mt-14" aria-labelledby="cast-title">
    <h2 id="cast-title" class="section-title">চরিত্রদের চেনো</h2>
    <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
      {cast.map((c) => (
        <li class="card flex flex-col items-center p-4 text-center">
          <span class="block h-20 w-20" set:html={castSvg(c)} />
          <p class="mt-2 text-lg font-bold">{CAST[c].bn}</p>
          <p class="text-sm leading-snug text-ink-soft">{CAST[c].line}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap mt-14">
    <div class="card grid gap-4 bg-tint p-6 sm:grid-cols-[1fr_auto] sm:items-center">
      <div>
        <h2 class="text-2xl font-bold">ক্লাসে দেখাতে চান?</h2>
        <p class="mt-1 text-ink-soft">প্রতিটি পর্বের সাথে বয়স-নির্দেশনা, আলোচনার প্রশ্ন আর ছাপানো যায় এমন ওয়ার্কশিট আছে।</p>
      </div>
      <a href="/teachers" class="btn btn-secondary">শিক্ষকদের কিট</a>
    </div>
  </section>
</BaseLayout>
