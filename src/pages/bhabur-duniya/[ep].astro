---
import DemoEpisodePage from '../../components/episodes/DemoEpisodePage.astro';
import RealEpisodePage from '../../components/episodes/RealEpisodePage.astro';
import { liveEpisodes } from '../../lib/content';
import { realEpisodes, type RealEpisode } from '../../lib/realEpisodes';
import type { Episode } from '../../data/types';

export function getStaticPaths() {
  const real = realEpisodes.map((ep) => ({ params: { ep: ep.slug }, props: { real: true, ep } }));
  const taken = new Set(realEpisodes.map((e) => e.slug));
  const demo = liveEpisodes.filter((e) => !taken.has(e.slug)).map((ep, i, all) => ({
    params: { ep: ep.slug },
    props: { real: false, ep, next: all[i + 1] ?? null, prev: all[i - 1] ?? null },
  }));
  return [...real, ...demo];
}
const p = Astro.props as { real: boolean; ep: Episode | RealEpisode; next?: Episode | null; prev?: Episode | null };
---
{p.real ? <RealEpisodePage ep={p.ep as RealEpisode} /> : <DemoEpisodePage ep={p.ep as Episode} next={p.next ?? null} prev={p.prev ?? null} />}
