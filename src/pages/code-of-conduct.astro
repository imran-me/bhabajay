---
import BaseLayout from '../layouts/BaseLayout.astro';
import Doodle from '../components/brand/Doodle.astro';

const rules = [
  { d: 'heart', t: 'ভদ্র থাকো', b: 'মানুষকে না, যুক্তিকে প্রশ্ন করো। ঠাট্টা চলবে, অপমান না। কারো চেহারা, ধর্ম, লিঙ্গ, এলাকা বা বয়স নিয়ে বাজে কথা মানে সাথে সাথে মন্তব্য মুছে ফেলা।' },
  { d: 'eye', t: 'তথ্য যাচাই করো', b: 'দাবি করলে সূত্র দাও। না জানলে “জানি না” বলা সাহসের কাজ। স্বাস্থ্য নিয়ে কখনো চিকিৎসার পরামর্শ দেবে না — ডাক্তার দেখাতে বলো।' },
  { d: 'paw', t: 'নিজেকে আর অন্যকে নিরাপদ রাখো', b: 'ফোন নম্বর, ঠিকানা, স্কুলের নাম, ছবি — নিজের বা কারো ব্যক্তিগত তথ্য চাইবে না, দেবে না। কেউ চাইলে রিপোর্ট করো।' },
  { d: 'bulb', t: 'অন্যের কাজের ক্রেডিট দাও', b: 'অন্যের ছবি, লেখা বা আইডিয়া ব্যবহার করলে নাম লেখো। কপি করা কাজ প্রকাশ হয় না।' },
  { d: 'sparkle', t: 'ভুল হলে ঠিক করো', b: 'ভুল তথ্য প্রকাশ হয়ে গেলে লুকাবে না — সংশোধন করে তারিখ দিয়ে জানাবে। এটাই বিজ্ঞানের পদ্ধতি।' },
] as const;
---
<BaseLayout title="আচরণবিধি" description="ভাবা যায়! কমিউনিটির পাঁচটা নিয়ম: ভদ্রতা, তথ্য যাচাই, নিরাপত্তা, ক্রেডিট আর সংশোধন।">
  <article class="wrap max-w-3xl pt-6 sm:pt-10">
    <h1 class="font-display text-[2.2rem] leading-tight sm:text-5xl">আচরণবিধি</h1>
    <p class="mt-2 text-lg text-ink-soft">ভাবা যায়! কৌতূহলের জায়গা। কৌতূহল বাঁচে তখনই, যখন সবাই নিরাপদ বোধ করে। পাঁচটা নিয়ম:</p>
    <ol class="mt-8 grid gap-3">
      {rules.map((r, i) => (
        <li class="card flex gap-4 p-5">
          <Doodle name={r.d} class="h-12 w-12" />
          <div><h2 class="text-xl font-bold">{['১', '২', '৩', '৪', '৫'][i]}. {r.t}</h2><p class="mt-1 text-ink-soft">{r.b}</p></div>
        </li>
      ))}
    </ol>
    <div class="mt-8 rounded-[22px] bg-tint p-5">
      <h2 class="font-bold">নিয়ম ভাঙলে কী হয়?</h2>
      <p class="mt-1 text-ink-soft">প্রথমবার: মন্তব্য সরানো আর একটা বন্ধুত্বপূর্ণ বার্তা। বারবার: মন্তব্য ও পিচের সুযোগ বন্ধ। নিরাপত্তার ঝুঁকি হলে (যেমন কিশোরের ব্যক্তিগত তথ্য চাওয়া): সাথে সাথে অ্যাকাউন্ট বন্ধ, প্রয়োজনে অভিভাবক ও কর্তৃপক্ষকে জানানো।</p>
      <p class="mt-2 text-sm text-ink-soft">রিপোর্ট করতে: <a href="/contact" class="link">যোগাযোগ</a> · খসড়া ০.১ — কোর মিটিংয়ে চূড়ান্ত হবে।</p>
    </div>
  </article>
</BaseLayout>
