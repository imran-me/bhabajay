# ───────────────────────────────────────────────────────────────
# ভাবা যায়! — environment
# Copy to `.env` and fill in. With the two Supabase values empty the
# site runs in DEMO MODE: Bhaba Jay ID, scores, pitches, comments and
# inboxes are stored in the visitor's browser (localStorage) only.
# ───────────────────────────────────────────────────────────────

# Public site URL (canonical links, sitemap, OG images)
PUBLIC_SITE_URL=https://bhabajay.com

# Supabase (Auth + Postgres). Anon key is safe in the browser: every
# table is protected by row-level security (see supabase/migrations).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Partner + social links (owner to confirm the real URLs)
PUBLIC_DELTA_URL=
PUBLIC_FACEBOOK_URL=
PUBLIC_YOUTUBE_URL=

# Build-time only: Facebook Pages API for the nightly import script
# (scripts/import-facebook.mjs). Never prefix these with PUBLIC_.
FB_PAGE_ID=
FB_PAGE_TOKEN=
